# Sericulture Edge-AI — Environment Variables
# Copy to .env and fill in values. NEVER commit real secrets.

# --- Device Identity ---
SERICULTURE_DEVICE_ID=changeme-device-id
SERICULTURE_FARM_ID=changeme-farm-id

# --- AWS IoT Core ---
# Paths to X.509 certificate and private key (absolute paths on Pi)
AWS_IOT_ENDPOINT=changeme.iot.ap-south-1.amazonaws.com
AWS_IOT_CERT_PATH=/etc/sericulture/certs/device.pem.crt
AWS_IOT_KEY_PATH=/etc/sericulture/certs/device.private.key
AWS_IOT_ROOT_CA_PATH=/etc/sericulture/certs/AmazonRootCA1.pem

# --- Optional overrides ---
# SERICULTURE_CONFIG_PATH=/etc/sericulture/device.yaml
# SERICULTURE_DB_PATH=/var/lib/sericulture/sericulture.db
# SERICULTURE_LOG_LEVEL=INFO
