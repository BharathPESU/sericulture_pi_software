# ==============================================================================
# Sericulture Edge-AI Pi 5 Controller — Environment Variables (.env)
# ==============================================================================
# Copy this file to `.env` (for local development) or `/etc/sericulture/sericulture.env`
# (for the production systemd service).
#
# IMPORTANT:
# - Secure this file: chmod 600 .env (readable only by the owner)
# - NEVER commit real secrets, private keys, or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Device & Farm Identity
# ------------------------------------------------------------------------------
# Unique hardware device serial or ID (e.g., SERI-PI5-001)
SERICULTURE_DEVICE_ID=SERI-PI5-001

# Farm / Tenant / Cluster identifier (e.g., FARM-KAR-042)
SERICULTURE_FARM_ID=FARM-KAR-042

# Rearing shed or site name within the farm
SERICULTURE_SITE_NAME=Rearing-Shed-A

# ------------------------------------------------------------------------------
# 2. AWS IoT Core Connection & Endpoints
# ------------------------------------------------------------------------------
# Enable or disable AWS IoT synchronization (true | false)
AWS_IOT_ENABLED=true

# AWS IoT Core Data-ATS endpoint (Find via: aws iot describe-endpoint --endpoint-type iot:Data-ATS)
# Example: a3xxxxxxxxxxxx-ats.iot.ap-south-1.amazonaws.com
AWS_IOT_ENDPOINT=changeme-ats.iot.ap-south-1.amazonaws.com

# AWS Region where your IoT Core registry and policies reside
AWS_IOT_REGION=ap-south-1

# MQTT Client ID (defaults to SERICULTURE_DEVICE_ID if left empty)
AWS_IOT_CLIENT_ID=SERI-PI5-001

# ------------------------------------------------------------------------------
# 3. AWS IoT Core X.509 TLS Certificates
# ------------------------------------------------------------------------------
# Absolute paths to the device certificate and private key on the Raspberry Pi
AWS_IOT_CERT_PATH=/etc/sericulture/certs/device.cert.pem
AWS_IOT_KEY_PATH=/etc/sericulture/certs/device.private.key

# Absolute path to the Amazon Root CA 1 certificate (Downloaded from Amazon Trust Services)
AWS_IOT_ROOT_CA_PATH=/etc/sericulture/certs/AmazonRootCA1.pem

# ------------------------------------------------------------------------------
# 4. AWS IoT MQTT Topics & Outbox Sync Options
# ------------------------------------------------------------------------------
# Root MQTT topic namespace
# Events are published to: <topic_root>/devices/<device_id>/<channel>
# Channels: telemetry, events, health, acks
AWS_IOT_TOPIC_ROOT=novabion/sericulture/v1

# MQTT Quality of Service (0 = at most once, 1 = at least once)
AWS_IOT_QOS=1

# Application-level durable acknowledgment timeout in seconds
AWS_IOT_ACK_TIMEOUT_S=30.0

# Number of pending SQLite outbox records to transmit per batch
AWS_IOT_BATCH_SIZE=20

# Interval between sync loop drain attempts in seconds
AWS_IOT_BATCH_INTERVAL_S=15.0

# Maximum retry attempts before marking an outbox event as failed
AWS_IOT_MAX_RETRY_COUNT=50

# ------------------------------------------------------------------------------
# 5. Local Storage & Database Configuration
# ------------------------------------------------------------------------------
# Absolute path to local SQLite database (WAL mode enabled)
SERICULTURE_DB_PATH=/var/lib/sericulture/sericulture.db

# Minimum required free disk space in megabytes before warning/lockout
SERICULTURE_MIN_FREE_DISK_MB=200

# ------------------------------------------------------------------------------
# 6. Configuration File & Runtime Settings
# ------------------------------------------------------------------------------
# Path to device YAML configuration file
SERICULTURE_CONFIG_PATH=/etc/sericulture/device.yaml

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SERICULTURE_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 7. Hardware & Fault Behavior Flags
# ------------------------------------------------------------------------------
# When set to true, AWS IoT connectivity failures will NOT trigger FAULT_LOCKOUT
# at boot (allows fully offline rearing shed monitoring and actuation)
SERICULTURE_OPTIONAL_AWS_IOT=true

# When set to true, missing HDMI/DSI display will not prevent system boot
SERICULTURE_OPTIONAL_DISPLAY=true
